# --- Site ---
# Canonical production URL. REQUIRES CLIENT APPROVAL (domain ownership must be verified first).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Lead delivery ---
# Optional webhook (CRM / Zapier / Make / email service) that receives each lead as JSON POST.
# If unset, leads are persisted to var/leads/ on the server and an ops warning is logged.
LEAD_WEBHOOK_URL=

# Optional shared secret sent as X-Lead-Token header to the webhook.
LEAD_WEBHOOK_TOKEN=

# --- Analytics ---
# Optional. Events are no-ops until an analytics provider is wired in lib/analytics.ts.
NEXT_PUBLIC_ANALYTICS_ID=

# --- Content gating ---
# "true" shows portfolio entries whose approval status is still pending (preview/staging only).
# MUST be "false" in production until the client approves projects. See docs/APPROVALS.md.
NEXT_PUBLIC_SHOW_PENDING_CONTENT=true
