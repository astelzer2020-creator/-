# Atlas dev environment — variable NAMES only, never values (docs/SECURITY.md).
# See README.md in this directory for setup and the migrate flow.

# Postgres connection string, e.g. postgresql://user@127.0.0.1:54329/atlas.
# Set  -> pg repositories + pg user store, /readyz pings the DB.
# Unset -> in-memory adapters (nothing persists across restarts).
DATABASE_URL=

# HS256 signing secret for access tokens (min 32 chars). Never committed.
JWT_SECRET=

# Base URL of the INTERNAL analytics service (never internet-facing).
ANALYTICS_URL=

# Dev/pilot-UAT only: seeds two orgs / four users idempotently at boot
# (org A: admin/analyst/viewer@atlas.local; org B: analyst-b@atlas.local).
# Unset -> no users seeded, login impossible (safe default).
SEED_USER_PASSWORD=

# Optional (defaults: 127.0.0.1 / 3000 / development)
# HOST=
# PORT=
# NODE_ENV=

# Tests only: dedicated Postgres DB for the pg integration suite —
# it is TRUNCATED between tests. Unset -> pg suite skips.
DATABASE_URL_TEST=
